<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.godzilla.distribution.mapper.shared.UserLoginSessionEntityMapper">
    <resultMap id="BaseResultMap" type="com.godzilla.distribution.entity.shared.UserLoginSessionEntity">
        <id column="id" jdbcType="BIGINT" property="id"/>
        <result column="openid" jdbcType="VARCHAR" property="openid"/>
        <result column="skey" jdbcType="VARCHAR" property="skey"/>
        <result column="biz" jdbcType="VARCHAR" property="biz"/>
        <result column="login_source" jdbcType="VARCHAR" property="loginSource"/>
        <result column="expire_time" jdbcType="TIMESTAMP" property="expireTime"/>
        <result column="create_time" jdbcType="TIMESTAMP" property="createTime"/>
    </resultMap>

    <sql id="BaseColumnList">
        id, openid, skey, biz, login_source, expire_time, create_time
    </sql>

    <select id="selectBySkeyAndBiz" resultMap="BaseResultMap">
        select
        <include refid="BaseColumnList"/>
        from user_login_session
        where skey = #{skey}
          and biz = #{biz}
          and expire_time > #{now}
    </select>
</mapper>
