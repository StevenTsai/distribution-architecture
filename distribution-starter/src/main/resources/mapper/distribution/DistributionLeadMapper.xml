    <sql id="BaseColumnList">
        id, lead_no, patient_name, patient_phone, source_distributor_id, source_member_id, intent_product_line,
        source_region, source_channel, owner_user_id, stage, is_duplicate, duplicate_lead_id, invalid_reason,
        remark, latest_follow_up_at, created_by, updated_by, create_time, modify_time, deleted
    </sql>

    <sql id="ConditionWhere">
        where deleted = 0
        <if test="leadNo != null and leadNo != ''">
            and lead_no = #{leadNo}
        </if>
        <if test="patientKeyword != null and patientKeyword != ''">
            and (patient_name like concat('%', #{patientKeyword}, '%')
            or patient_phone like concat('%', #{patientKeyword}, '%'))
        </if>
        <if test="sourceDistributorId != null">
            and source_distributor_id = #{sourceDistributorId}
        </if>
        <if test="intentProductLine != null and intentProductLine != ''">
            and intent_product_line = #{intentProductLine}
        </if>
        <if test="ownerUserId != null">
            and owner_user_id = #{ownerUserId}
        </if>
        <if test="stage != null and stage != ''">
            and stage = #{stage}
        </if>
    </sql>

    <sql id="ScopeCondition">
        <if test="authorizedDistributorIds != null and authorizedDistributorIds.size() > 0">
            and source_distributor_id in
            <foreach collection="authorizedDistributorIds" item="authorizedDistributorId" open="(" separator="," close=")">
                #{authorizedDistributorId}
            </foreach>
        </if>
        <if test="authorizedMemberId != null or authorizedOwnerUserId != null">
            and (
            <if test="authorizedMemberId != null">
                source_member_id = #{authorizedMemberId}
            </if>
            <if test="authorizedMemberId != null and authorizedOwnerUserId != null">
                or
            </if>
            <if test="authorizedOwnerUserId != null">
                owner_user_id = #{authorizedOwnerUserId}
            </if>
            )
        </if>
    </sql>

    <select id="countByCondition" resultType="java.lang.Long">
        select count(*)
        from distribution_lead
        <include refid="ConditionWhere"/>
    </select>

    <select id="selectByCondition" resultMap="BaseResultMap">
        select
        <include refid="BaseColumnList"/>
        from distribution_lead
        <include refid="ConditionWhere"/>
        order by create_time desc, id desc
        limit #{offset}, #{limit}
    </select>

    <select id="countByConditionWithScope" resultType="java.lang.Long">
        select count(*)
        from distribution_lead
        <include refid="ConditionWhere"/>
        <include refid="ScopeCondition"/>
    </select>

    <select id="selectByConditionWithScope" resultMap="BaseResultMap">
        select
        <include refid="BaseColumnList"/>
        from distribution_lead
