    <select id="selectByIds" resultMap="BaseResultMap">
        select
        <include refid="BaseColumnList"/>
        from distribution_lead
        where deleted = 0
          and id in
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </select>

    <select id="selectByPatientPhone" resultMap="BaseResultMap">
        select
        <include refid="BaseColumnList"/>
        from distribution_lead
        where patient_phone = #{patientPhone}
          and deleted = 0
        <if test="excludeId != null">
            and id != #{excludeId}
        </if>
        order by create_time asc, id asc
        limit 1
    </select>

    <select id="selectByReferrerAndPatientPhone" resultMap="BaseResultMap">
        select
        <include refid="BaseColumnList"/>
        from distribution_lead
        where patient_phone = #{patientPhone}
          and deleted = 0
        <choose>
            <when test="sourceMemberId != null">
                and source_member_id = #{sourceMemberId}
            </when>
            <otherwise>
                and source_member_id is null
                <if test="sourceDistributorId != null">
                    and source_distributor_id = #{sourceDistributorId}
                </if>
            </otherwise>
        </choose>
        <if test="excludeId != null">
            and id != #{excludeId}
        </if>
        order by create_time asc, id asc
        limit 1
    </select>

    <select id="selectDuplicateLead" resultMap="BaseResultMap">
        select
        <include refid="BaseColumnList"/>
        from distribution_lead
        where patient_phone = #{patientPhone}
          and intent_product_line = #{intentProductLine}
